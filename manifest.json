{
"manifest_version": 3,
"name": "PanPan",
"version": "1.0",
"description": "Guided panel view for long-strip manga readers by PanPan.",
"action": {
"default_popup": "popupui.html"
},
"permissions": [
"activeTab",
"scripting"
],
"host_permissions": [
"https://kagane.to/*",
"https://*.kagane.to/*"
],
"content_scripts": [
{
"matches": [
"https://kagane.to/*",
"https://*.kagane.to/*"
],
"js": ["content.js"]
}
],
"browser_specific_settings": {
"gecko": {
"id": "panelzoom@yourdomain.com",
"strict_min_version": "109.0"
}
}
}