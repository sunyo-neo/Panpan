{
"manifest_version": 3,
"name": "PanPan",
"version": "1.0",
"description": "Guided panel view for long-strip manga readers by PanPan.",
"icons": {
"16": "icons/icon16.png",
"48": "icons/icon48.png",
"128": "icons/icon128.png"
},
"action": {
"default_popup": "popupui.html",
"default_icon": {
"16": "icons/icon16.png",
"48": "icons/icon48.png",
"128": "icons/icon128.png"
}
},
"permissions": [
"activeTab",
"scripting",
"storage"
],
"host_permissions": [
"https://kagane.to/*",
"https://*.kagane.to/*"
],
"content_scripts": [
{
"matches": [
"https://kagane.to/*",
"https://*.kagane.to/*"
],
"js": ["dist/content.js"]
}
],
"browser_specific_settings": {
"gecko": {
"id": "panelzoom@yourdomain.com",
"strict_min_version": "109.0"
}
}
}